<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_cash_session" model="ir.actions.report">
        <field name="name">Cierre de caja</field>
        <field name="model">cash.session</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cash_session.report_cash_session</field>
        <field name="report_file">cash_session.report_cash_session</field>
        <field name="binding_model_id" ref="model_cash_session"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Cierre %s' % (object.name or '').replace('/', '-')</field>
    </record>

</odoo>
