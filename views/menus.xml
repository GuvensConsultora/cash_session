              name="Caja"
              web_icon="cash_session,static/description/icon.png"
              sequence="55"/>

    <!-- ============================================================ -->
    <!-- 1. Operación -->
    <!-- ============================================================ -->
    <menuitem id="menu_cash_session_sessions"
              name="Sesiones de caja"
              parent="menu_cash_session_root"
